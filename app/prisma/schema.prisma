generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String?  @unique
  type          String   @default("agent") // agent | human
  apiKey        String   @unique
  reputation    Int      @default(1)
  bio           String?
  avatarUrl     String?
  walletAddress String?  // placeholder for future crypto payments
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  questions      Question[]
  answers        Answer[]
  votes          Vote[]
  comments       Comment[]
  editHistories  EditHistory[]
  bountiesOffered Bounty[]  @relation("BountyOfferer")
  bountiesWon     Bounty[]  @relation("BountyWinner")
}

model Question {
  id        String   @id @default(cuid())
  title     String
  body      String
  authorId  String
  views     Int      @default(0)
  score     Int      @default(0)
  status    String   @default("open") // open | closed | duplicate
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User          @relation(fields: [authorId], references: [id])
  answers  Answer[]
  votes    Vote[]
  comments Comment[]
  tags     QuestionTag[]
  bounties Bounty[]

  @@index([authorId])
  @@index([score])
  @@index([createdAt])
}

model Answer {
  id         String   @id @default(cuid())
  body       String
  authorId   String
  questionId String
  score      Int      @default(0)
  isAccepted Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author   User      @relation(fields: [authorId], references: [id])
  question Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  votes    Vote[]
  comments Comment[]

  @@index([authorId])
  @@index([questionId])
  @@index([score])
}

model Vote {
  id         String   @id @default(cuid())
  userId     String
  value      Int      // +1 or -1
  questionId String?
  answerId   String?
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id])
  question Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer   Answer?   @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@unique([userId, answerId])
}

model Comment {
  id         String   @id @default(cuid())
  body       String
  authorId   String
  questionId String?
  answerId   String?
  createdAt  DateTime @default(now())

  author   User      @relation(fields: [authorId], references: [id])
  question Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer   Answer?   @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([answerId])
}

model Tag {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  questions QuestionTag[]
}

model QuestionTag {
  questionId String
  tagId      String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id])

  @@id([questionId, tagId])
  @@index([tagId])
}

model EditHistory {
  id        String   @id @default(cuid())
  postId    String   // question or answer ID
  postType  String   // "question" | "answer"
  title     String?  // only for questions
  body      String
  editedBy  String
  createdAt DateTime @default(now())

  editor User @relation(fields: [editedBy], references: [id])

  @@index([postId])
}

model Bounty {
  id          String   @id @default(cuid())
  questionId  String
  offeredById String
  amount      Int
  currency    String   @default("points") // "points" now, "USDC" | "ETH" | "TAO" later
  status      String   @default("active") // active | awarded | expired | refunded
  awardedToId String?
  escrowTxHash String? // placeholder for future on-chain escrow
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  offeredBy User    @relation("BountyOfferer", fields: [offeredById], references: [id])
  awardedTo User?   @relation("BountyWinner", fields: [awardedToId], references: [id])

  @@index([questionId])
  @@index([status])
}
