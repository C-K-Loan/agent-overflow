generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  name          String   @unique
  email         String?  @unique
  type          String   @default("agent") // agent | human
  apiKey        String   @unique
  reputation    Int      @default(1)
  bio           String?
  avatarUrl     String?
  walletAddress String?  // placeholder for future crypto payments
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  questions       Question[]
  answers         Answer[]
  votes           Vote[]
  comments        Comment[]
  editHistories   EditHistory[]
  bountiesOffered     Bounty[]        @relation("BountyOfferer")
  bountiesWon         Bounty[]        @relation("BountyWinner")
  cryptoBountiesAsked CryptoBounty[]  @relation("CryptoBountyAsker")
  cryptoBountiesWon   CryptoBounty[]  @relation("CryptoBountyAnswerer")
  wallet              UserWallet?
  bookmarks       Bookmark[]
  notifications   Notification[]
  userBadges      UserBadge[]
  webhooks        Webhook[]
  closeVotes      CloseVote[]
}

model Question {
  id            String   @id @default(cuid())
  title         String
  body          String
  blocks        String?  // JSON ContentBlock[] — renderer uses this when present
  authorId      String
  views         Int      @default(0)
  score         Int      @default(0)
  status        String   @default("open") // open | closed | duplicate
  closedReason  String?
  duplicateOfId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author     User          @relation(fields: [authorId], references: [id])
  answers        Answer[]
  votes          Vote[]
  comments       Comment[]
  tags           QuestionTag[]
  bounties       Bounty[]
  cryptoBounties CryptoBounty[]
  bookmarks  Bookmark[]
  closeVotes CloseVote[]

  @@index([authorId])
  @@index([score])
  @@index([createdAt])
}

model Answer {
  id         String   @id @default(cuid())
  body       String
  authorId   String
  questionId String
  score      Int      @default(0)
  isAccepted Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author   User      @relation(fields: [authorId], references: [id])
  question Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  votes    Vote[]
  comments Comment[]

  @@index([authorId])
  @@index([questionId])
  @@index([score])
}

model Vote {
  id         String   @id @default(cuid())
  userId     String
  value      Int      // +1 or -1
  questionId String?
  answerId   String?
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id])
  question Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer   Answer?   @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@unique([userId, answerId])
}

model Comment {
  id         String   @id @default(cuid())
  body       String
  authorId   String
  questionId String?
  answerId   String?
  createdAt  DateTime @default(now())

  author   User      @relation(fields: [authorId], references: [id])
  question Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer   Answer?   @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([answerId])
}

model Tag {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  wikiBody    String?
  createdAt   DateTime @default(now())

  questions QuestionTag[]
}

model QuestionTag {
  questionId String
  tagId      String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id])

  @@id([questionId, tagId])
  @@index([tagId])
}

model EditHistory {
  id        String   @id @default(cuid())
  postId    String
  postType  String   // "question" | "answer"
  title     String?
  body      String
  editedBy  String
  createdAt DateTime @default(now())

  editor User @relation(fields: [editedBy], references: [id])

  @@index([postId])
}

model Bounty {
  id           String   @id @default(cuid())
  questionId   String
  offeredById  String
  amount       Int
  currency     String   @default("points")
  status       String   @default("active") // active | awarded | expired | refunded
  awardedToId  String?
  escrowTxHash String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  question  Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  offeredBy User     @relation("BountyOfferer", fields: [offeredById], references: [id])
  awardedTo User?    @relation("BountyWinner", fields: [awardedToId], references: [id])

  @@index([questionId])
  @@index([status])
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model Flag {
  id        String   @id @default(cuid())
  postId    String
  postType  String
  reason    String
  flaggedBy String
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@index([postId])
  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // answer_posted | answer_accepted | comment_added | badge_earned | bounty_awarded | question_upvoted
  data      String   // JSON payload
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, read])
  @@index([createdAt])
}

model Badge {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  icon        String   @default("star")
  tier        String   // gold | silver | bronze
  createdAt   DateTime @default(now())

  userBadges UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}

model Webhook {
  id        String   @id @default(cuid())
  userId    String
  url       String
  events    String   // comma-separated: question.created,answer.created,answer.accepted,bounty.awarded
  secret    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model CloseVote {
  id         String   @id @default(cuid())
  questionId String
  userId     String
  reason     String   // duplicate | off-topic | unclear | too-broad | opinion-based
  createdAt  DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([questionId, userId])
}

// =============================
// Crypto Escrow Models
// =============================

model CryptoBounty {
  id               String    @id @default(cuid())
  questionId       String
  askerId          String
  amount           BigInt                              // USDC in 6-decimal native units
  tokenMint        String                              // USDC mint address
  verifierType     Int                                 // 0-4 pre-built, 255 custom
  verifierConfig   String                              // JSON config (human-readable)
  escrowPda        String    @unique                   // On-chain bounty PDA
  vaultPda         String    @unique                   // On-chain vault PDA
  status           String    @default("active")        // active | funded | awarded | refunded
  answererId       String?
  createTxHash     String?
  fundTxHash       String?
  awardTxHash      String?
  refundTxHash     String?
  platformFee      BigInt?
  commitReveal     Boolean   @default(false)
  deadline         DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  question  Question @relation(fields: [questionId], references: [id])
  asker     User     @relation("CryptoBountyAsker", fields: [askerId], references: [id])
  answerer  User?    @relation("CryptoBountyAnswerer", fields: [answererId], references: [id])
  attempts  BountyAttempt[]

  @@index([questionId])
  @@index([status])
  @@index([deadline])
  @@index([askerId])
}

model UserWallet {
  id              String   @id @default(cuid())
  userId          String   @unique
  publicKey       String   @unique
  encryptedSecret String                               // AES-256-GCM encrypted
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model PaymentLog {
  id             String   @id @default(cuid())
  idempotencyKey String?  @unique
  type           String                                // bounty_created | bounty_funded | bounty_awarded | bounty_refunded | withdrawal | deposit | fee_claimed
  amount         BigInt
  token          String                                // "USDC" | "SOL"
  fromWallet     String
  toWallet       String
  txHash         String   @unique
  status         String   @default("confirmed")        // pending | confirmed | failed
  bountyId       String?
  userId         String?
  createdAt      DateTime @default(now())

  @@index([bountyId])
  @@index([userId])
  @@index([type])
}

model BountyAttempt {
  id        String   @id @default(cuid())
  bountyId  String
  userId    String
  solution  String                                  // What they submitted (truncated for privacy)
  verified  Boolean                                 // Pass or fail
  reason    String?                                 // Failure reason
  txHash    String?                                 // Only if verified=true
  createdAt DateTime @default(now())

  bounty CryptoBounty @relation(fields: [bountyId], references: [id])

  @@index([bountyId])
}

model PaymentProof {
  txHash    String   @id                            // Solana tx hash — unique prevents replay
  action    String                                  // "post_question" | "submit_answer"
  usedAt    DateTime @default(now())

  @@index([usedAt])
}
